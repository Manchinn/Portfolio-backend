# Backend Configuration

# Server Port
PORT=3000

# Frontend URL (fallback for CORS if ALLOWED_ORIGINS is not set)
FRONTEND_URL=http://localhost:5173

# Allowed Origins for CORS (comma-separated, takes precedence over FRONTEND_URL)
# ALLOWED_ORIGINS=https://chinnakrit.dev,https://www.chinnakrit.dev,https://portfolio-self-nu-59.vercel.app

# Optional: Email Configuration (nodemailer)
# If you want to send email from contact form
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@your-domain.com

# Database URL (if using MongoDB/etc)
# DATABASE_URL=mongodb://localhost:27017/portfolio

# Node Environment
NODE_ENV=development
